PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://admin:admin@localhost:27017/renda-fixa-monitor?authSource=admin
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=7d
# Cookies de sessão usam o atributo Secure em produção (HTTPS).
COOKIE_SECURE=false
BCRYPT_SALT_ROUNDS=10

# Storage (driver ativo — minio por padrão)
STORAGE_DRIVER=minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=renda-fixa-monitor
S3_USE_SSL=false

