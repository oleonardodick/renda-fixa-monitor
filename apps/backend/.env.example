PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://admin:admin@localhost:27017/renda-fixa-monitor?authSource=admin
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=7d
# Cookies de sessão usam o atributo Secure em produção (HTTPS).
COOKIE_SECURE=false
BCRYPT_SALT_ROUNDS=10

# Rate limiting da API
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=900000

# Storage (driver ativo — minio por padrão)
STORAGE_DRIVER=minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=renda-fixa-monitor
S3_USE_SSL=false

# Redis (infraestrutura; nenhuma feature o utiliza ainda)
REDIS_HOST=localhost
REDIS_PORT=6379
# Autenticação: preencher somente quando o Redis exigir usuário e senha.
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
# Habilita TLS na conexão. Manter false em desenvolvimento.
REDIS_TLS=false
# Prefixo aplicado a todas as chaves, separando os dados desta aplicação.
REDIS_KEY_PREFIX=renda-fixa-monitor:
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_RECONNECT_MAX_RETRIES=3
REDIS_RECONNECT_BASE_DELAY_MS=200
# Quando true, a API não sobe sem o Redis. Padrao: false (sobe e avisa).
REDIS_REQUIRED_ON_STARTUP=false

